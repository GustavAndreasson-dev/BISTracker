<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="BISTracker.Presentation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BIS Tracker">
    <Grid x:Name="Root" Background="#10131A" RequestedTheme="Dark" Language="en-US">
        <Grid.Resources>
            <SolidColorBrush x:Key="AccentBrush" Color="#E6C477" />
            <SolidColorBrush x:Key="MutedBrush" Color="#9AA4B6" />
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="#191E28" />
                <Setter Property="BorderBrush" Value="#2B3342" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18,12" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#151923" BorderBrush="#2B3342" BorderThickness="0,0,1,0">
            <Grid Margin="22,30,22,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <Border Width="42" Height="42" HorizontalAlignment="Left" Background="#332C20" CornerRadius="10">
                        <TextBlock Text="✦" FontSize="28" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="BIS TRACKER" FontSize="19" FontWeight="Bold" CharacterSpacing="90" />
                    <TextBlock Text="Every upgrade counts." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,42,0,0" Spacing="14">
                    <TextBlock Text="YOUR GEAR" FontSize="11" CharacterSpacing="120" Foreground="{StaticResource MutedBrush}" />
                    <Border Background="#302C23" CornerRadius="8" Padding="14,12" BorderBrush="#5B4C2F" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8D4;" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding NavigationLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <ComboBox x:Name="CharacterPicker" Header="Character" HorizontalAlignment="Stretch" ItemsSource="{Binding Characters}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedCharacter, Mode=OneWay}" SelectionChanged="CharacterChanged" IsEnabled="{Binding IsInteractive}" />
                    <Button Content="New character" HorizontalAlignment="Stretch" Click="NewCharacterClicked" IsEnabled="{Binding IsInteractive}" />
                    <ComboBox x:Name="SpecializationPicker" Header="Specialization" HorizontalAlignment="Stretch" ItemsSource="{Binding Specializations}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSpecialization, Mode=OneWay}" SelectionChanged="SpecializationChanged" IsEnabled="{Binding IsInteractive}" />
                    <ComboBox x:Name="CatalogPicker" Header="Catalog" HorizontalAlignment="Stretch" ItemsSource="{Binding CatalogSets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCatalogSet, Mode=OneWay}" SelectionChanged="CatalogChanged" IsEnabled="{Binding IsInteractive}" />
                    <Button Content="Import catalogs" HorizontalAlignment="Stretch" Click="ImportCatalogClicked" IsEnabled="{Binding CanImportCatalog}" />
                    <TextBlock Text="{Binding CatalogContext}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="26,22,26,18" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Spacing="7">
                    <TextBlock Text="{Binding CatalogLabel}" FontSize="11" CharacterSpacing="60" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding ListTitle}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Track what you own and what you wear." Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding SelectionMethod}" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="OWNED SLOTS" FontSize="11" CharacterSpacing="90" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding OwnedSummary}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        <ProgressBar Value="{Binding OwnedCount}" Maximum="{Binding TotalCount}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="EQUIPPED SLOTS" FontSize="11" CharacterSpacing="90" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding EquippedSummary}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Currently worn by your character" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="MISSING SLOTS" FontSize="11" CharacterSpacing="90" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding RemainingCount}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Your next collection goals" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
            <StackPanel Grid.Row="2" Spacing="8">
                <InfoBar IsOpen="{Binding HasCatalogGaps}" IsClosable="False" Severity="Warning" Title="Catalog incomplete" Message="{Binding CatalogStatus}" />
                <InfoBar IsOpen="{Binding ShowClassicContext}" IsClosable="False" Severity="Informational" Title="Phase 1 pre-raid BiS" Message="Dungeons, including UBRS (10 players), quests and crafting. Sources and conditions are listed below." />
                <InfoBar IsOpen="{Binding HasDraftProgress}" IsClosable="False" Severity="Informational" Title="Your draft progress is preserved" Message="The real list starts with a separate collection. Marks on fictional draft items have not been transferred." />
                <InfoBar IsOpen="{Binding HasError}" IsClosable="False" Severity="Error" Title="Could not update progress" Message="{Binding ErrorMessage}" />
            </StackPanel>
            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Search items, slots or dungeons" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsInteractive}" AutomationProperties.Name="Search gear" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" IsEnabled="{Binding IsInteractive}" AutomationProperties.Name="Filter progress">
                    <ComboBoxItem Content="All slots" />
                    <ComboBoxItem Content="Missing slots" />
                    <ComboBoxItem Content="Owned slots" />
                    <ComboBoxItem Content="Equipped slots" />
                </ComboBox>
            </Grid>
            <Border Grid.Row="4" Background="#171C25" BorderBrush="#2B3342" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="20,13" Background="#1D2330" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition Width="85" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SLOT" FontSize="10" CharacterSpacing="80" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Text="ITEM ALTERNATIVES" FontSize="10" CharacterSpacing="80" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="2" Text="OWNED" FontSize="10" CharacterSpacing="60" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="3" Text="EQUIPPED" FontSize="10" CharacterSpacing="60" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                    <ListView x:Name="EquipmentList" Grid.Row="1" ItemsSource="{Binding VisibleSlots}" SelectionMode="None" IsItemClickEnabled="False" IsEnabled="{Binding IsInteractive}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SlotName}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding VisibleAlternatives}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                <Border BorderBrush="#262E3B" BorderThickness="0,0,0,1" Padding="20,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="85" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="1" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" VerticalAlignment="Top" Margin="0,4,0,0" Background="#252B38" BorderBrush="#5B4C2F" BorderThickness="1" CornerRadius="4">
                                                <Grid>
                                                    <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Visibility="{Binding IconPlaceholderVisibility}" AutomationProperties.Name="Item icon unavailable" />
                                                    <Image Source="{Binding IconUrl}" Stretch="Uniform" ImageOpened="ItemIconOpened" ImageFailed="ItemIconFailed" AutomationProperties.Name="{Binding Name}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <HyperlinkButton Content="{Binding Name}" NavigateUri="{Binding ItemUri}" HorizontalAlignment="Left" Padding="0" MinHeight="0" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" ToolTipService.ToolTip="Open item details" />
                                                <TextBlock Text="{Binding Source}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                                <HyperlinkButton Content="Recommendation source ↗" NavigateUri="{Binding RecommendationUri}" HorizontalAlignment="Left" Padding="0" MinHeight="0" FontSize="10" ToolTipService.ToolTip="Open the guide used for this recommendation" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox Grid.Column="2" MinWidth="0" Width="32" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsOwned, Mode=OneWay}" Click="OwnedClicked" AutomationProperties.Name="{Binding OwnedAccessibleName}" ToolTipService.ToolTip="Mark as owned" />
                                        <CheckBox Grid.Column="3" MinWidth="0" Width="32" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsEquipped, Mode=OneWay}" Click="EquippedClicked" AutomationProperties.Name="{Binding EquippedAccessibleName}" ToolTipService.ToolTip="Mark as equipped" />
                                    </Grid>
                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="2" Text="{Binding EmptyMessage}" Visibility="{Binding EmptyStateVisibility}" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="12" />
                </Grid>
            </Border>
            <Grid Grid.Row="5">
                <TextBlock Text="{Binding SaveStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding VisibleSummary}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </Grid>
        </Grid>
    </Grid>
</Window>
